# ── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Where the frontend is served (used to build buyer/seller transaction links).
APP_BASE_URL=http://localhost:5173
# Public URL of THIS backend.
PUBLIC_BASE_URL=http://localhost:4000

# ── Bitcoin (Signet) ─────────────────────────────────────
# BITCOIN_LIVE=false (default) simulates escrow/funding/txids. true = real P2WSH 2-of-3 escrow,
# Esplora funding detection, PSBT signing and broadcast (needs ARBITRATOR_PUBKEY).
BITCOIN_LIVE=false
BITCOIN_NETWORK=signet
BITCOIN_ESPLORA_URL=https://mempool.space/signet/api
BITCOIN_FEE_RATE=2
BITCOIN_RPC_URL=http://127.0.0.1:38332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_MIN_CONFIRMATIONS=1
# The arbitrator's own multisig pubkey — the third key in every order's 2-of-3 escrow.
ARBITRATOR_PUBKEY=

# ── Nostr ────────────────────────────────────────────────
# NOT WIRED UP YET — see backend/src/lib/nostr.js.
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
NOSTR_SERVICE_PRIVKEY=

# ── AI (provider adapters: openai | anthropic) ────────────
# Default: OpenAI's smallest/cheapest model. Set LLM_PROVIDER=anthropic (+ ANTHROPIC_API_KEY)
# to use Claude Haiku 5.5 instead. Verify the model name against your account's model list.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=gpt-5-nano
LLM_TIMEOUT_MS=30000
# OpenAI only: reasoning effort (gpt-5 family) and image detail (low = cheapest).
# LLM_REASONING_EFFORT=minimal
# LLM_IMAGE_DETAIL=low
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx   # and LLM_MODEL=claude-haiku-5-5

# ── Escrow policy ────────────────────────────────────────
# Buyer review window before a ghosted transaction escalates to arbitration (PRD §6.4 —
# this does NOT auto-release; a human still signs off via the arbitration console).
REVIEW_WINDOW_HOURS=24
# For demos, override the window with a short value in seconds (takes priority when > 0).
REVIEW_WINDOW_SECONDS=90

# ── Ops ──────────────────────────────────────────────────
# Comma-separated Nostr pubkeys (64-hex) promoted to ADMIN on first login. Bootstrap only.
ADMIN_PUBKEYS=
SESSION_TTL_HOURS=24
# BITCOIN_CHAIN=rpc uses Bitcoin Core (watch-only wallet) instead of Esplora.
# BITCOIN_CHAIN=rpc  BITCOIN_RPC_URL=http://127.0.0.1:18443  BITCOIN_RPC_USER=...  BITCOIN_RPC_PASSWORD=...
# Enables the /simulate-funding helper + faster demo behaviour.
DEMO_MODE=true
