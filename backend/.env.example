# ── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Where the frontend is served (used to build buyer/seller transaction links).
APP_BASE_URL=http://localhost:5173
# Public URL of THIS backend.
PUBLIC_BASE_URL=http://localhost:4000

# ── Bitcoin (Signet) ─────────────────────────────────────
# NOT WIRED UP YET — see backend/src/lib/bitcoin.js. Until it's implemented, escrow
# creation and funding detection are simulated regardless of these values.
BITCOIN_NETWORK=signet
BITCOIN_RPC_URL=http://127.0.0.1:38332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_MIN_CONFIRMATIONS=1
# The arbitrator's own multisig pubkey — the third key in every order's 2-of-3 escrow.
ARBITRATOR_PUBKEY=

# ── Nostr ────────────────────────────────────────────────
# NOT WIRED UP YET — see backend/src/lib/nostr.js.
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
NOSTR_SERVICE_PRIVKEY=

# ── AI (Groq, OpenAI-compatible) ─────────────────────────
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# Verify this is a currently-valid, vision-capable model on your Groq account before
# relying on AI verification — see README §12 "Known issues".
LLM_MODEL=qwen/qwen3.6-27b

# ── Escrow policy ────────────────────────────────────────
# Buyer review window before a ghosted transaction escalates to arbitration (PRD §6.4 —
# this does NOT auto-release; a human still signs off via the arbitration console).
REVIEW_WINDOW_HOURS=24
# For demos, override the window with a short value in seconds (takes priority when > 0).
REVIEW_WINDOW_SECONDS=90

# ── Ops ──────────────────────────────────────────────────
# Protects the internal arbitration console API.
ADMIN_TOKEN=change-me-admin-token
# Enables the /simulate-funding helper + faster demo behaviour.
DEMO_MODE=true
